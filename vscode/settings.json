{
    "editor.bracketPairColorization.enabled": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.guides.bracketPairs": "active",
    "editor.codeActionsOnSave": {
    },
    "editor.inlineSuggest.enabled": true,
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80,
        120
    ],
    "editor.tabSize": 2,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.wordWrap": "wordWrapColumn",
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.formatOnSave": true
    },
    "[java]": {
        "editor.defaultFormatter": "mwpb.java-prettier-formatter"
    },
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off",
        },
        "editor.defaultFormatter": "darkriszty.markdown-table-prettify",
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "files.autoSave": "afterDelay",
    "git.autofetch": true,
    "githubIssues.ignoreCompletionTrigger": [
        "coffeescript",
        "diff",
        "dockerfile",
        "dockercompose",
        "ignore",
        "ini",
        "julia",
        "makefile",
        "perl",
        "powershell",
        "python",
        "r",
        "ruby",
        "shellscript",
        "yaml",
        "markdown"
    ],
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "default"
        },
        {
            "label": "Created Issues",
            "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
        },
        {
            "label": "Recent Issues",
            "query": "state:open repo:${owner}/${repository} sort:updated-desc"
        }
    ],
    "githubPullRequests.pullBranch": "never",
    "gitlens.views.commits.files.layout": "tree",
    "go.toolsManagement.autoUpdate": true,
    "markdown.extension.toc.levels": "1..3",
    "markdown.extension.toc.updateOnSave": false,
    "redhat.telemetry.enabled": true,
    "terminal.external.osxExec": "nu",
    "terminal.integrated.inheritEnv": false,
    "tws.highlightOnlyChangedLines": true,
    "vale.valeCLI.config": "",
    "vale.doNotShowWarningForFileToBeSavedBeforeLinting": true,
    "vale.valeCLI.path": "${workspaceFolder}/node_modules/.bin/vale",
    "vale.enableSpellcheck": true,
    "workbench.editorAssociations": {
        "*.mod": "default"
    },
    "workbench.startupEditor": "none",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
    "githubPullRequests.fileListLayout": "tree",
    "markdown.extension.toc.omittedFromToc": {
        
    },
    "spectral.validateFiles": [
        "**/api-docs/**/*.yml",
        "**/api-docs/**/*.yaml"
    ],
    "spectral.validateLanguages": [
        "json",
        "yaml",
        "yml"
    ],
    "git.suggestSmartCommit": false,
    "github.copilot.advanced": {

        "length": 500,               // Maximum length of completions (default: 500)
        "temperature": 0.7,          // Controls randomness (0-1, default: 0.7)
        "topP": 1,                   // Controls diversity via nucleus sampling (default: 1)
        "indentationMode": "auto",   // How to handle indentation (auto/standard)
        "listCount": 10,             // Number of suggestions to generate (default: 10)
        "inlineSuggestCount": 3,     // Number of inline suggestions to show (default: 3)
        "debug": false,              // Enable debug logging
        "model": "default",          // AI model to use
        "completionProvider": "",    // Custom completion provider path
        "confidenceThreshold": 0.6   // Threshold for suggestion confidence
    },
    "workbench.editor.enablePreview": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "github.copilot.chat.codesearch.enabled": true,
    "redoclyOpenAPI.user.anonymousId": "7df88d1b-6cb9-46b3-9034-4773a72ac6fc",
    "diffEditor.ignoreTrimWhitespace": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "docker.extension.enableComposeLanguageServer": false,
    "terminal.external.linuxExec": "nu",
    "terminal.integrated.automationProfile.linux": {

    },
    "terminal.integrated.suggest.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "security.promptForLocalFileProtocolHandling": false,
    "commentAnchors.tags.anchors": {
        
        "ANCHOR": {
            "iconColor": "default",
            "highlightColor": "#A8C023",
            "scope": "file"
        },
        "TODO": {
            "iconColor": "blue",
            "highlightColor": "#3ea8ff",
            "scope": "workspace"
        },
        "FIXME": {
            "iconColor": "red",
            "highlightColor": "#F44336",
            "scope": "workspace"
        },
        "STUB": {
            "iconColor": "purple",
            "highlightColor": "#BA68C8",
            "scope": "file"
        },
        "NOTE": {
            "iconColor": "orange",
            "highlightColor": "#FFB300",
            "scope": "file"
        },
        "REVIEW": {
            "iconColor": "green",
            "highlightColor": "#64DD17",
            "scope": "workspace"
        },
        "SECTION": {
            "iconColor": "blurple",
            "highlightColor": "#896afc",
            "scope": "workspace",
            "behavior": "region"
        },
        "LINK": {
            "iconColor": "#2ecc71",
            "highlightColor": "#2ecc71",
            "scope": "workspace",
            "behavior": "link"
        }
    },
    "editor.autoClosingQuotes": "beforeWhitespace",
    "chat.mcp.discovery.enabled": {
        "claude-desktop": true,
        "windsurf": true,
        "cursor-global": true,
        "cursor-workspace": true
    },
    "python.analysis.typeCheckingMode": "standard",
    "comments.thread.confirmOnCollapse": "never",
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "vim.enable": true,
    "vim.overrideCopy": false,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.relativeNumber": true,
    "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "w"],
            "commands": ["workbench.action.files.save"]
        },
        {
            "before": ["<leader>", "q"],
            "commands": ["workbench.action.closeActiveEditor"]
        }
    ]
}