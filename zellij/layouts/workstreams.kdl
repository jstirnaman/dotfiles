// Workstreams layout: single "main" session, 3 tabs. gh-dash is NOT a tab —
// float it on demand with Alt+g (bound in config.kdl), cwd-aware to whichever
// pane is focused.
//
// Launch (new session): zellij --new-session-with-layout workstreams -s main
// (Plain `--session`+`--layout` together is broken on zellij 0.44 -
// https://github.com/zellij-org/zellij/issues/3734 - use --new-session-with-layout instead.)
// Attach: zellij attach main
// Or just run the `workstreams` shell function (handles attach-or-create).

layout {
  tab_template name="ws" {
    pane size=1 borderless=true {
      plugin location="tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="status-bar"
    }
  }

  // Docs workstream: docs-tooling + docs-v2 side by side, plus an agent pane.
  ws name="docs" focus=true split_direction="vertical" cwd="__INFLUXDATA__/docs-tooling" {
    pane name="docs-tooling"
    pane name="DAR" cwd="__INFLUXDATA__/DAR"
    pane name="docs-v2" cwd="__INFLUXDATA__/docs-v2"
    pane name="agent" cwd="__INFLUXDATA__/docs-tooling"
  }

  // MCP server workstream.
  ws name="mcp" split_direction="vertical" cwd="__INFLUXDATA__/influxdb3_mcp_server" {
    pane name="mcp" cwd="__INFLUXDATA__/influxdb3_mcp_server"
    pane name="mcp" cwd="__INFLUXDATA__/docs-tooling"
  }

  // Background monitors.
  ws name="background" split_direction="vertical" cwd="__INFLUXDATA__" {
    pane name="monitor-influxdb3-core"
    pane name="monitor-influxdb3-ent"
    pane name="monitor-influxdb1-ent"
    pane name="monitor-influxdb2"
    pane name="monitor-telegraf"
  }
}
