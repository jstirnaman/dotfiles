# wtreap [repo_root|worktree_path] — remove cattle whose branch merged into origin default.
#   No arg: sweep all cattle worktrees for the repo in $PWD.
#   repo_root: sweep all cattle worktrees for that repo.
#   worktree_path: reap ONLY that worktree (never sweeps siblings), if merged.
#   Only touches cattle under ~/worktrees (or legacy ~/.worktrees), never slots.
#   Prints a count.
#
#   CAVEAT: `merge-base --is-ancestor` detects merge/rebase merges, NOT squash-merges
#   (GitHub's default). If you squash-merge PRs, swap the test marked below for the
#   gh-based one, which keys death off the PR being MERGED.

emulate -L zsh

if [[ $1 == -h || $1 == --help ]]; then
  print "usage: wtreap [repo_root|worktree_path]"
  print "  no arg          reap merged cattle worktrees for the repo in \$PWD"
  print "  repo_root       reap merged cattle worktrees for that repo"
  print "  worktree_path   reap only that one worktree, if its branch merged"
  return 0
fi

local input=${1:-$PWD}
local common_dir repo_root
common_dir=$(git -C "$input" rev-parse --git-common-dir 2>/dev/null) || { print -u2 "wtreap: not a git repo or worktree: $input"; return 1 }
[[ $common_dir == /* ]] || common_dir=$input/$common_dir
repo_root=${common_dir:h}

local def n=0
def=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD); def=${def#origin/}
git -C "$repo_root" fetch -qp origin

local target=""
if [[ -n $1 ]] && ! [[ $1 -ef $repo_root ]]; then
  target=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || { print -u2 "wtreap: not a git worktree: $1"; return 1 }
fi

reap_one() {
  local wt=$1 br
  [[ $wt == "$HOME/worktrees/"* || $wt == "$HOME/.worktrees/"* ]] || { print -u2 "wtreap: refusing, not cattle (not under ~/worktrees): $wt"; return 1 }
  br=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1

  # --- merge test (merge/rebase merges) ---
  if git -C "$repo_root" merge-base --is-ancestor "$br" "origin/$def" 2>/dev/null; then
  # --- squash-merge test (swap the line above for this) ---
  # if [[ $(gh pr view "$br" --json state -q .state 2>/dev/null) == MERGED ]]; then
    git -C "$repo_root" worktree remove --force "$wt" && git -C "$repo_root" branch -D "$br" 2>/dev/null && return 0
  fi
  return 1
}

if [[ -n $target ]]; then
  reap_one "$target" && (( n++ ))
else
  local wt
  for wt in ${(f)"$(git -C "$repo_root" worktree list --porcelain | awk '/^worktree /{print $2}')"}; do
    reap_one "$wt" && (( n++ ))
  done
fi

print "wtreap: removed $n merged worktree(s)."
