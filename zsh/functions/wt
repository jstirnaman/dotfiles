# wt [branch] [start] — create an EPHEMERAL (cattle) worktree, born to be reaped.
#   ~/worktrees/<repo>/<branch>  (a visible path for people and agent UIs)
#   New branch off <start> (any commit-ish), default origin's default branch.
#   No name given (or "") => machine-named throwaway.
#   Cattle have a death condition: reap with `wtreap`, remove one with `wtrm`.

emulate -L zsh

local repo_root repo def branch start dir base wt_path
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || { print -u2 "wt: not in a git repo"; return 1 }
repo=${repo_root:t}
def=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); def=${def#origin/}
[[ -z $def ]] && { git -C "$repo_root" show-ref -q refs/remotes/origin/main && def=main || def=master }

branch=${1:-wip/$(date +%m%d-%H%M)}          # unnamed => don't bond with it
dir=${branch//\//-}
base=$HOME/worktrees/$repo
mkdir -p "$base"
wt_path=$base/$dir
[[ -e $wt_path ]] && { print -u2 "wt: exists: $wt_path"; return 1 }

start=${2:-origin/$def}
[[ -z $2 ]] && git -C "$repo_root" fetch -q origin "$def"
# Adopt a branch that already exists, locally or on origin; create it otherwise.
if git -C "$repo_root" show-ref -q --verify "refs/heads/$branch"; then
	git -C "$repo_root" worktree add "$wt_path" "$branch" >/dev/null || return
elif git -C "$repo_root" show-ref -q --verify "refs/remotes/origin/$branch"; then
	git -C "$repo_root" worktree add --track -b "$branch" "$wt_path" "origin/$branch" >/dev/null || return
else
	git -C "$repo_root" worktree add -b "$branch" "$wt_path" "$start" >/dev/null || return
fi

print -r -- "$wt_path"
